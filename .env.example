POSTGRES_USER=postgres
POSTGRES_PASSWORD=example
POSTGRES_DB=mlops
PORT=8080
DATABASE_URL=postgres://postgres:example@postgres:5432/mlops?sslmode=disable

# AWS Lambda (replaces direct OpenAI calls)
LAMBDA_FUNCTION_NAME=your-lambda-function-name
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key

# Async callback (EC2 only) — set to the public URL of this backend so Lambda
# can POST results back instead of blocking. Leave unset for sync mode (local dev).
# Example: BACKEND_BASE_URL=http://<ec2-public-ip>:8080
BACKEND_BASE_URL=
